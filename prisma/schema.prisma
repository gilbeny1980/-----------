// Prisma schema for the Gilam Electrical Department task management system

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model Electrician {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  birthDate DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  workOrders WorkOrder[]
}

model WorkOrder {
  id              String          @id @default(cuid())
  title           String
  description     String?
  status          WorkOrderStatus @default(OPEN)
  equipmentIssued String?
  createdAt       DateTime        @default(now())

  electricianId String?
  electrician   Electrician? @relation(fields: [electricianId], references: [id], onDelete: SetNull)

  @@index([electricianId])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model AppSettings {
  id              String @id @default("singleton")
  workOrdersTitle String @default("משימות")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(TODO)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  comments Comment[]
}

model Transformer {
  id            String   @id @default(cuid())
  name          String
  order         Int      @default(0)
  activePowerKw Float?
  powerFactor   Float?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ServiceCategory {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  companies ServiceCompany[]
}

model ServiceCompany {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  categoryId String
  category   ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contacts   ServiceContact[]

  @@index([categoryId])
}

model ServiceContact {
  id    String  @id @default(cuid())
  name  String
  role  String?
  phone String?

  companyId String
  company   ServiceCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ElectricalRoom {
  id       String  @id @default(cuid())
  panel    Int?
  name     String
  location String?
  area     String?
  qrCode   String  @unique

  entries RoomEntry[]
}

model RoomEntry {
  id        String   @id @default(cuid())
  phone     String
  enteredAt DateTime @default(now())

  roomId String
  room   ElectricalRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([enteredAt])
}
