// Prisma schema for the Gilam Electrical Department task management system

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ProjectStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Electrician {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  birthDate DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(TODO)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  comments Comment[]
}

model Transformer {
  id            String   @id @default(cuid())
  name          String
  order         Int      @default(0)
  activePowerKw Float?
  powerFactor   Float?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}
